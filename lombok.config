# 상위 디렉터리로 lombok.config 탐색이 올라가지 않게 여기서 멈춘다.
config.stopBubbling = true

# Lombok 이 필드에서 생성자 파라미터로 복사할 애노테이션.
# 기본 목록에 스프링 애노테이션이 없어서, 이 줄이 없으면 @RequiredArgsConstructor 가 만든
# 생성자에 @Value 가 붙지 않는다 -> 스프링이 String 타입 빈을 찾다가 기동에 실패한다.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
